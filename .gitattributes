# Le catalogue publie (site/) est servi tel quel, et les empreintes SHA-1 que
# porte catalogue.json sont calculees sur les octets que le generateur ecrit,
# en LF. Laisser git le ressortir en CRLF sur un poste Windows a deux effets
# desagreables :
#
#   tool/verify_catalogue.dart echoue sur chaque empreinte quand on verifie
#   une copie locale, alors que le site publie (servi depuis Linux, donc en
#   LF) est parfaitement bon ;
#
#   les 127 fichiers apparaissent modifies apres chaque regeneration, alors
#   que leur contenu est identique. On finit par ne plus regarder git status.
site/** text eol=lf

# Le generateur et ses sources d'accents ecrivent aussi en LF. Meme raison :
# regenerer ne doit pas salir l'arbre de travail.
app/buzzer_companion/tool/** text eol=lf

# Flutter reecrit ces fichiers en LF a chaque build. Sans cette ligne, ils
# apparaissent modifies apres chaque compilation alors que leur contenu est
# identique, et on finit par ne plus lire git status.
app/buzzer_companion/windows/flutter/** text eol=lf

# LA BANQUE EMBARQUEE EST UNE COPIE OCTET POUR OCTET de site/banque.json : le
# generateur ecrit le site puis copie dans les assets. Elle manquait ici, et
# git lui rendait un CRLF au checkout alors que sa jumelle du site restait en
# LF. Les deux fichiers cessaient d'etre identiques pour un seul octet, et
# tool/verify_banque.dart annoncait « ne correspond pas a la banque publiee »
# apres chaque git pull, sur une banque parfaitement bonne. Un outil qui crie
# au loup finit par ne plus etre lu.
app/buzzer_companion/assets/questions/banque.json text eol=lf
