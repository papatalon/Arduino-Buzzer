{
  // Compile le sketch pour l'Arduino Mega et génère build/Buzzer.ino.hex/.elf
  // (utilisés par wokwi.toml). Lancer AVANT "Wokwi: Start Simulator" pour
  // éviter de simuler un binaire périmé.
  //
  // Raccourci : Ctrl+Shift+B (tâche de build par défaut).
  // Si arduino-cli est dans le PATH, remplace "command" par "arduino-cli".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compiler (Arduino Mega)",
      "type": "process",
      "command": "C:/Program Files/Arduino CLI/arduino-cli.exe",
      "args": [
        "compile",
        "--fqbn", "arduino:avr:mega",
        "--output-dir", "build",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
